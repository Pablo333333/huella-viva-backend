// Configuración de Huella Viva 360 - MVP
// Habilitamos extensiones de PostgreSQL para PostGIS

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
}

enum Role {
  ADMIN_TERRITORIAL
  EMPRESA
  ESTADO
  COMUNIDAD
}

enum ProjectStatus {
  CULMINADO
  EN_GESTION
  EN_EJECUCION
}

enum ProjectType {
  EDUCACION
  SALUD
  AGUA
  SANEAMIENTO
  INFRAESTRUCTURA
  OTROS
}

enum ActivityType {
  REUNION
  INSPECCION
  VISITA
  TALLER
  OTRO
}

enum CommitmentStatus {
  PROGRAMADO
  EN_PROCESO
  CUMPLIDO
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  name       String?
  role       Role       @default(COMUNIDAD)
  pushToken  String?
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Community {
  id         String     @id @default(uuid())
  nombre     String
  poblacion  Int        @default(0)
  // Usamos Unsupported para tipos geográficos de PostGIS
  location   Float? // Temporal hasta activar PostGIS
  boundary   String? // Temporal hasta activar PostGIS
  activities Activity[]
  projects   Project[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Project {
  id           String        @id @default(uuid())
  nombre       String
  tipo         ProjectType   @default(OTROS)
  presupuesto  Float         @default(0)
  financiador  String?
  estado       ProjectStatus @default(EN_GESTION)
  community    Community     @relation(fields: [communityId], references: [id])
  communityId  String
  investments  Investment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Investment {
  id          String   @id @default(uuid())
  descripcion String
  monto       Float
  location    Float? // Temporal
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id          String       @id @default(uuid())
  tipo        ActivityType @default(VISITA)
  descripcion String
  fecha       DateTime     @default(now())
  audioUrl    String?
  fotoUrl     String?
  location    Float? // Legacy: latitud aproximada
  latitude    Float? // GPS real del dispositivo
  longitude   Float? // GPS real del dispositivo
  
  user        User         @relation(fields: [userId], references: [id])
  userId      String
  community   Community    @relation(fields: [communityId], references: [id])
  communityId String
  
  commitments Commitment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Commitment {
  id                 String           @id @default(uuid())
  descripcion        String
  responsable        String
  fecha_cumplimiento DateTime?
  estado             CommitmentStatus @default(PROGRAMADO)
  
  activity           Activity         @relation(fields: [activityId], references: [id])
  activityId         String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  entityId     String
  entityType   String
  payloadHash  String
  previousHash String?
  timestamp    DateTime @default(now())
}
